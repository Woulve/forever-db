package-as: ForeverDB

move-folders:
  ForeverDB/ForeverDB: ForeverDB
  ForeverDB/ForeverDB_Full: ForeverDB_Full
  ForeverDB/ForeverDB_Locales: ForeverDB_Locales

ignore:
  - tools
  - tests
  - slices
  - collected
  - recorded
  - work
  - dist
  - out
  - REPORT.md
  - sources.json
  - README.md
  - LICENSE-DATA.txt
  - manifest.json
  - .github
